    "type": "magento2-module",
    "version": "2.0.0",
    "license": "GPL-3.0-or-later",
    "homepage": "https://www.billmysales.com",
    "authors": [
        {
            "name": "BillMySales",
            "homepage": "https://www.billmysales.com"
        }
    ],
    "support": {
