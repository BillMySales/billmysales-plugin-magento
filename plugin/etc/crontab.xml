<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="billmysales_process_due_deliveries"
             instance="BillMySales\Magento\Cron\ProcessDueDeliveries" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>
