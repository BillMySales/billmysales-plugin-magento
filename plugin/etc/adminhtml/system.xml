<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="billmysales" translate="label" type="text" sortOrder="200"
                 showInDefault="1" showInWebsite="1" showInStore="0">
            <label>BillMySales</label>
            <tab>service</tab>
            <resource>BillMySales_Magento::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Settings</label>
                <field id="active" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Active</label>
                    <comment>When off, no orders are sent; the settings are kept.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>billmysales/general/active</config_path>
                </field>
                <field id="webhook" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Notification URL</label>
                    <comment>URL BillMySales gave you for this integration.</comment>
                    <config_path>billmysales/general/webhook</config_path>
                </field>
                <field id="token" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Secret</label>
                    <comment>The secret shared with BillMySales, used to sign each notification.</comment>
                    <frontend_model>BillMySales\Magento\Block\Adminhtml\System\Config\Secret</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <config_path>billmysales/general/token</config_path>
                </field>
                <field id="notify_statuses" translate="label" type="multiselect" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Order statuses that notify</label>
                    <source_model>BillMySales\Magento\Model\Config\Source\OrderStatuses</source_model>
                    <config_path>billmysales/general/notify_statuses</config_path>
                </field>
            </group>
            <group id="checkout_fields" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Checkout fields</label>
                <field id="definitions" translate="label comment" type="textarea" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Fields</label>
                    <comment>
                        Added to the checkout's shipping address form and sent with the order.
                    </comment>
                    <frontend_model>BillMySales\Magento\Block\Adminhtml\System\Config\CheckoutFields</frontend_model>
                    <backend_model>BillMySales\Magento\Model\Config\Backend\CheckoutFields</backend_model>
                    <config_path>billmysales/checkout_fields/definitions</config_path>
                </field>
            </group>
        </section>
    </system>
</config>
